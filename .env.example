# Terminus environment variables (docs/spec/architecture.md — Environment).
#
# The repo-local cluster is owned by the scripts: `scripts/db-up.sh` prints the
# authoritative, eval-able export lines for this checkout (absolute socket
# path). Paste those here or source them directly:
#   eval "$(scripts/db-up.sh)"

# Dev database (libpq URI; host is the unix socket dir — absolute path).
DATABASE_URL=postgresql:///stoptime?host=/home/you/es2/tp2/.pg/sock&port=5543

# Test database — rebuilt by scripts/testdb.sh; integration tests connect here.
TEST_DATABASE_URL=postgresql:///stoptime_test?host=/home/you/es2/tp2/.pg/sock&port=5543

# HTTP listen address. Default 127.0.0.1:8080.
LISTEN_ADDR=127.0.0.1:8080

# Session signing key, 32+ bytes. Required in production; the server ships a
# fixed dev default until T6 (auth) lands. Generate: openssl rand -base64 32.
SESSION_KEY=dev-insecure-fixed-session-key-change-me
