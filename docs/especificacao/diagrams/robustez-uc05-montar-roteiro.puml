@startuml robustez-uc05-montar-roteiro
left to right direction
skinparam shadowing false
title UC05 — Montar roteiro diário

actor "Gerente (role: manager)" as Gerente
boundary "Route builder" as B1
control "CreateRoute" as C1
control "RN05: UNIQUE (driver_user_id, route_date)" as C2
control "RN06: stop_order 1..n" as C3
control "AddStop / ReorderStops / RemoveStop" as C4
entity "route" as E1
entity "route_stop" as E2
entity "location" as E3
entity "audit_log" as E4

Gerente --> B1
B1 --> C1
C1 --> C2
C1 --> C3
C1 --> E1
C1 --> E2
C1 --> E3
B1 --> C4
C4 --> E2
C4 --> E3
C4 --> E4
@enduml
