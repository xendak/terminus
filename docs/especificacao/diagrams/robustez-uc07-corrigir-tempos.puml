@startuml robustez-uc07-corrigir-tempos
left to right direction
skinparam shadowing false
title UC07 — Corrigir horários registrados

actor "Gerente (role: manager)" as Gerente
boundary "History (route detail)" as B1
control "UpdateStopTimes" as C1
control "RN02: departure_at >= arrival_at" as C3
control "RNF05: audit_log" as C2
entity "route_stop" as E1
entity "audit_log" as E2

Gerente --> B1
B1 --> C1
C1 --> C3
C1 --> E1
C1 --> C2
C2 --> E2
@enduml
